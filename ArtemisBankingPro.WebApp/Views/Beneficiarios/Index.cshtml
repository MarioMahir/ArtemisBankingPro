@model BeneficiariosIndexViewModel
@{
    ViewData["Title"] = "Beneficiarios";
}

<h2 class="abp-page-title">Beneficiarios</h2>
<div class="abp-divider-accent"></div>

<div class="card mb-3">
    <div class="card-header">Agregar beneficiario</div>
    <div class="card-body">
        <form asp-action="Agregar" method="post" class="row g-2 align-items-start">
            <div class="col-md-4">
                <input asp-for="Nuevo.AccountNumber" name="AccountNumber" class="form-control"
                       placeholder="Número de cuenta (9 dígitos)" maxlength="9" />
                <span asp-validation-for="Nuevo.AccountNumber" class="text-validation"></span>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Agregar</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table abp-table mb-0">
            <thead>
            <tr>
                <th>Nº cuenta</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Beneficiarios.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">@Mensajes.SinBeneficiarios</td></tr>
            }
            @foreach (var beneficiario in Model.Beneficiarios)
            {
                <tr>
                    <td class="abp-producto-numero">@beneficiario.AccountNumber</td>
                    <td>@beneficiario.HolderFirstName</td>
                    <td>@beneficiario.HolderLastName</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEliminarBeneficiario"
                                data-beneficiario-id="@beneficiario.Id">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@* Modal de confirmación de eliminación *@
<div class="modal fade" id="modalEliminarBeneficiario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar beneficiario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">@Mensajes.ConfirmarEliminarBeneficiario</p>
            </div>
            <div class="modal-footer">
                <form asp-action="Eliminar" method="post">
                    <input type="hidden" name="id" id="modalEliminarBeneficiarioId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('modalEliminarBeneficiario').addEventListener('show.bs.modal', function (event) {
            document.getElementById('modalEliminarBeneficiarioId').value =
                event.relatedTarget.getAttribute('data-beneficiario-id');
        });
    </script>
}
