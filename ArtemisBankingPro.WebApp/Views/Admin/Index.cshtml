@model DashboardDto
@{
    ViewData["Title"] = "Home administrador";
}

<h2 class="abp-page-title">Panel del administrador</h2>
<p class="abp-page-subtitle">Indicadores generales del sistema</p>
<div class="abp-divider-accent"></div>

<div class="row g-3">
    @{
        var indicadores = new (string Icono, string Etiqueta, string Valor, string Extra)[]
        {
            ("🔁", "Transacciones históricas", Model.TotalTransactions.ToString("#,##0"), ""),
            ("📅", "Transacciones del día", Model.TransactionsToday.ToString("#,##0"), "stat-accent"),
            ("💳", "Pagos históricos", Model.TotalPayments.ToString("#,##0"), ""),
            ("🧾", "Pagos del día", Model.PaymentsToday.ToString("#,##0"), "stat-accent"),
            ("👥", "Clientes activos", Model.ActiveClients.ToString("#,##0"), "stat-success"),
            ("🚫", "Clientes inactivos", Model.InactiveClients.ToString("#,##0"), "stat-danger"),
            ("📦", "Productos financieros", Model.TotalActiveProducts.ToString("#,##0"), ""),
            ("🏦", "Préstamos vigentes", Model.ActiveLoans.ToString("#,##0"), ""),
            ("💳", "Tarjetas de crédito activas", Model.ActiveCreditCards.ToString("#,##0"), ""),
            ("💰", "Cuentas de ahorro activas", Model.ActiveSavingsAccounts.ToString("#,##0"), ""),
            ("📊", "Deuda promedio por cliente", Formato.Monto(Model.AverageDebtPerClient), "stat-accent")
        };
    }
    @foreach (var (icono, etiqueta, valor, extra) in indicadores)
    {
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card abp-stat-card @extra h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="abp-stat-icon">@icono</div>
                    <div>
                        <div class="abp-stat-label">@etiqueta</div>
                        <div class="abp-stat-value">@valor</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
