@model PaginacionViewModel

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination justify-content-center mt-3">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                <a class="page-link"
                   asp-action="@Model.Accion"
                   asp-all-route-data="@(new Dictionary<string, string>(Model.Ruta) { ["page"] = (Model.Pagina - 1).ToString() })">Anterior</a>
            </li>
            @for (var i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : null)">
                    <a class="page-link"
                       asp-action="@Model.Accion"
                       asp-all-route-data="@(new Dictionary<string, string>(Model.Ruta) { ["page"] = i.ToString() })">@i</a>
                </li>
            }
            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                <a class="page-link"
                   asp-action="@Model.Accion"
                   asp-all-route-data="@(new Dictionary<string, string>(Model.Ruta) { ["page"] = (Model.Pagina + 1).ToString() })">Siguiente</a>
            </li>
        </ul>
    </nav>
}
