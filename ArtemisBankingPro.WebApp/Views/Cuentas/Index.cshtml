@model CuentasIndexViewModel
@{
    ViewData["Title"] = "Gestión de cuentas de ahorro";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="abp-page-title">Gestión de cuentas de ahorro</h2>
        <div class="abp-divider-accent"></div>
    </div>
    <a class="btn btn-primary" asp-action="Asignar">Asignar cuenta</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="estado" class="form-select">
            @foreach (var estado in new[] { "Activas", "Canceladas", "Todas" })
            {
                @if (Model.Estado == estado)
                {
                    <option value="@estado" selected>@estado</option>
                }
                else
                {
                    <option value="@estado">@estado</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="tipo" class="form-select">
            @foreach (var tipo in new[] { "Todas", "Principal", "Secundaria" })
            {
                @if (Model.Tipo == tipo)
                {
                    <option value="@tipo" selected>@tipo</option>
                }
                else
                {
                    <option value="@tipo">@tipo</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="cedula" value="@Model.Cedula" class="form-control" placeholder="Buscar por cédula" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table abp-table mb-0">
            <thead>
            <tr>
                <th>Nº cuenta</th>
                <th>Cliente</th>
                <th>Balance</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Cuentas.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No hay cuentas para mostrar.</td></tr>
            }
            @foreach (var cuenta in Model.Cuentas.Items)
            {
                <tr>
                    <td class="abp-producto-numero">@cuenta.AccountNumber</td>
                    <td>@cuenta.ClientFullName</td>
                    <td class="abp-monto">@Formato.Monto(cuenta.Balance)</td>
                    <td>@(cuenta.Type == AccountType.Principal ? "Principal" : "Secundaria")</td>
                    <td>
                        <span class="badge badge-estado @(cuenta.Status == ProductStatus.Activa ? "badge-activo" : "badge-cancelado")">
                            @(cuenta.Status == ProductStatus.Activa ? "Activa" : "Cancelada")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@cuenta.AccountNumber">Detalle</a>
                        @if (cuenta.Status == ProductStatus.Activa && cuenta.Type == AccountType.Secundaria)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalCancelarCuenta"
                                    data-cuenta-numero="@cuenta.AccountNumber">
                                Cancelar
                            </button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion"
         model="@PaginacionViewModel.De(Model.Cuentas, ruta: new Dictionary<string, string> { ["estado"] = Model.Estado, ["tipo"] = Model.Tipo, ["cedula"] = Model.Cedula ?? string.Empty })" />

@* Modal de confirmación de cancelación (solo cuentas secundarias) *@
<div class="modal fade" id="modalCancelarCuenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancelar cuenta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="modalCancelarCuentaPregunta" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <form asp-action="Cancelar" method="post">
                    <input type="hidden" name="id" id="modalCancelarCuentaNumero" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalCancelarCuenta').addEventListener('show.bs.modal', function (event) {
            const boton = event.relatedTarget;
            const numero = boton.getAttribute('data-cuenta-numero');
            const plantilla = '@Html.Raw(Mensajes.ConfirmarCancelarCuenta)';
            document.getElementById('modalCancelarCuentaPregunta').textContent =
                plantilla.replace('{0}', numero);
            document.getElementById('modalCancelarCuentaNumero').value = numero;
        });
    </script>
}
