@model DetalleCuentaViewModel
@{
    ViewData["Title"] = $"Cuenta {Model.Cuenta.AccountNumber}";
}

<h2 class="abp-page-title">Cuenta <span class="abp-producto-numero">@Model.Cuenta.AccountNumber</span></h2>
<div class="abp-divider-accent"></div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row abp-confirm-detail mb-0">
            <dt class="col-sm-3">Titular</dt>
            <dd class="col-sm-3">@Model.Cuenta.ClientFullName</dd>
            <dt class="col-sm-3">Cédula</dt>
            <dd class="col-sm-3">@Model.Cuenta.ClientIdentification</dd>
            <dt class="col-sm-3">Balance</dt>
            <dd class="col-sm-3">@Formato.Monto(Model.Cuenta.Balance)</dd>
            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-3">@(Model.Cuenta.Type == AccountType.Principal ? "Principal" : "Secundaria")</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-3">
                <span class="badge badge-estado @(Model.Cuenta.Status == ProductStatus.Activa ? "badge-activo" : "badge-cancelado")">
                    @(Model.Cuenta.Status == ProductStatus.Activa ? "Activa" : "Cancelada")
                </span>
            </dd>
        </dl>
    </div>
</div>

<h5 class="abp-page-title">Transacciones</h5>
<div class="card">
    <div class="table-responsive">
        <table class="table abp-table mb-0">
            <thead>
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Monto</th>
                <th>Beneficiario</th>
                <th>Origen</th>
                <th>Estado</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Transacciones.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Esta cuenta no tiene transacciones registradas.</td></tr>
            }
            @foreach (var transaccion in Model.Transacciones.Items)
            {
                <tr>
                    <td>@Formato.FechaHora(transaccion.CreatedAt)</td>
                    <td>@(transaccion.Type == TransactionType.Debito ? "DÉBITO" : "CRÉDITO")</td>
                    <td class="abp-monto">@Formato.Monto(transaccion.Amount)</td>
                    <td>@transaccion.Beneficiary</td>
                    <td>@transaccion.Origin</td>
                    <td>
                        <span class="badge badge-estado @(transaccion.Status == TransactionStatus.Aprobada ? "badge-activo" : "badge-cancelado")">
                            @(transaccion.Status == TransactionStatus.Aprobada ? "APROBADA" : "RECHAZADA")
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion"
         model="@PaginacionViewModel.De(Model.Transacciones, "Detalle", new Dictionary<string, string> { ["id"] = Model.Cuenta.AccountNumber })" />

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
</div>
