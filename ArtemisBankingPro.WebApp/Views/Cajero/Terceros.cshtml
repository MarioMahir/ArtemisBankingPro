@model TercerosViewModel
@{
    ViewData["Title"] = "Transacciones a cuentas de terceros";
}

<h2 class="abp-page-title">Transacciones a cuentas de terceros</h2>
<div class="abp-divider-accent"></div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="Terceros" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-validation mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="SourceAccountNumber" class="form-label"></label>
                        <input asp-for="SourceAccountNumber" class="form-control" maxlength="9" autofocus />
                        <span asp-validation-for="SourceAccountNumber" class="text-validation"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DestinationAccountNumber" class="form-label"></label>
                        <input asp-for="DestinationAccountNumber" class="form-control" maxlength="9" />
                        <span asp-validation-for="DestinationAccountNumber" class="text-validation"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Amount" class="text-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Continuar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
