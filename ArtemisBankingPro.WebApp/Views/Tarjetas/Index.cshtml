@model TarjetasIndexViewModel
@{
    ViewData["Title"] = "Gestión de tarjetas de crédito";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="abp-page-title">Gestión de tarjetas de crédito</h2>
        <div class="abp-divider-accent"></div>
    </div>
    <a class="btn btn-primary" asp-action="Asignar">Asignar tarjeta</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="estado" class="form-select">
            @foreach (var estado in new[] { "Activas", "Canceladas", "Todas" })
            {
                @if (Model.Estado == estado)
                {
                    <option value="@estado" selected>@estado</option>
                }
                else
                {
                    <option value="@estado">@estado</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="cedula" value="@Model.Cedula" class="form-control" placeholder="Buscar por cédula" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table abp-table mb-0">
            <thead>
            <tr>
                <th>Nº tarjeta</th>
                <th>Cliente</th>
                <th>Límite</th>
                <th>Expiración</th>
                <th>Deuda</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Tarjetas.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay tarjetas para mostrar.</td></tr>
            }
            @foreach (var tarjeta in Model.Tarjetas.Items)
            {
                <tr>
                    <td class="abp-producto-numero">@tarjeta.MaskedCardNumber</td>
                    <td>@tarjeta.ClientFullName</td>
                    <td class="abp-monto">@Formato.Monto(tarjeta.CreditLimit)</td>
                    <td>@tarjeta.ExpirationDisplay</td>
                    <td class="abp-monto">@Formato.Monto(tarjeta.OwedAmount)</td>
                    <td>
                        <span class="badge badge-estado @(tarjeta.Status == ProductStatus.Activa ? "badge-activo" : "badge-cancelado")">
                            @(tarjeta.Status == ProductStatus.Activa ? "Activa" : "Cancelada")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@tarjeta.Id">Detalle</a>
                        @if (tarjeta.Status == ProductStatus.Activa)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditarLimite" asp-route-id="@tarjeta.Id">Editar</a>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalCancelarTarjeta"
                                    data-tarjeta-id="@tarjeta.Id"
                                    data-ultimos-cuatro="@tarjeta.LastFourDigits">
                                Cancelar
                            </button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion"
         model="@PaginacionViewModel.De(Model.Tarjetas, ruta: new Dictionary<string, string> { ["estado"] = Model.Estado, ["cedula"] = Model.Cedula ?? string.Empty })" />

@* Modal de confirmación de cancelación *@
<div class="modal fade" id="modalCancelarTarjeta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancelar tarjeta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="modalCancelarTarjetaPregunta" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <form asp-action="Cancelar" method="post">
                    <input type="hidden" name="id" id="modalCancelarTarjetaId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalCancelarTarjeta').addEventListener('show.bs.modal', function (event) {
            const boton = event.relatedTarget;
            const ultimos = boton.getAttribute('data-ultimos-cuatro');
            const plantilla = '@Html.Raw(Mensajes.ConfirmarCancelarTarjeta)';
            document.getElementById('modalCancelarTarjetaPregunta').textContent =
                plantilla.replace('{0}', ultimos);
            document.getElementById('modalCancelarTarjetaId').value = boton.getAttribute('data-tarjeta-id');
        });
    </script>
}
