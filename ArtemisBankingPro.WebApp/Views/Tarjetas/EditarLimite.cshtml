@model EditarLimiteViewModel
@{
    ViewData["Title"] = "Editar límite de crédito";
}

<h2 class="abp-page-title">Editar límite de crédito</h2>
<div class="abp-divider-accent"></div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                Tarjeta terminada en <strong>@Model.UltimosCuatro</strong> — @Model.ClienteNombre
            </div>
            <div class="card-body">
                <p class="abp-page-subtitle">
                    Límite actual: <strong>@Formato.Monto(Model.LimiteActual)</strong> ·
                    Deuda actual: <strong>@Formato.Monto(Model.Deuda)</strong>
                </p>
                <form asp-action="EditarLimite" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-validation mb-2"></div>
                    <input type="hidden" asp-for="CardId" />
                    <input type="hidden" asp-for="UltimosCuatro" />
                    <input type="hidden" asp-for="ClienteNombre" />
                    <input type="hidden" asp-for="LimiteActual" />
                    <input type="hidden" asp-for="Deuda" />

                    <div class="mb-3">
                        <label asp-for="NuevoLimite" class="form-label"></label>
                        <input asp-for="NuevoLimite" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="NuevoLimite" class="text-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Actualizar límite</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
