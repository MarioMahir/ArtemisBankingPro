@model AsignarTarjetaViewModel
@{
    ViewData["Title"] = "Asignar tarjeta de crédito";
}

<h2 class="abp-page-title">Asignar tarjeta — Paso 2: límite de crédito</h2>
<div class="abp-divider-accent"></div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                Cliente: <strong>@Model.ClienteNombre</strong>
                @if (!string.IsNullOrEmpty(Model.ClienteCedula))
                {
                    <span class="text-muted">— Cédula @Model.ClienteCedula</span>
                }
            </div>
            <div class="card-body">
                <form asp-action="Limite" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-validation mb-2"></div>
                    <input type="hidden" asp-for="ClientId" />

                    <div class="mb-3">
                        <label asp-for="CreditLimit" class="form-label"></label>
                        <input asp-for="CreditLimit" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="CreditLimit" class="text-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Asignar">Volver</a>
                        <button type="submit" class="btn btn-primary">Asignar tarjeta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
