@model ConfirmarRiesgoViewModel
@{
    ViewData["Title"] = "Advertencia de alto riesgo";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <h2 class="abp-page-title">Advertencia de alto riesgo</h2>
        <div class="abp-divider-accent"></div>

        <div class="alert alert-warning" role="alert">@Model.Advertencia</div>

        <div class="card">
            <div class="card-header">Detalle de la evaluación</div>
            <div class="card-body">
                <dl class="row abp-confirm-detail mb-0">
                    <dt class="col-sm-6">Cliente</dt>
                    <dd class="col-sm-6">@Model.ClienteNombre</dd>
                    <dt class="col-sm-6">Monto del préstamo</dt>
                    <dd class="col-sm-6">@Formato.Monto(Model.CapitalAmount)</dd>
                    <dt class="col-sm-6">Plazo</dt>
                    <dd class="col-sm-6">@Model.TermInMonths meses</dd>
                    <dt class="col-sm-6">Tasa anual</dt>
                    <dd class="col-sm-6">@Model.AnnualInterestRate.ToString("0.##")%</dd>
                    <dt class="col-sm-6">Total a pagar del nuevo préstamo</dt>
                    <dd class="col-sm-6">@Formato.Monto(Model.TotalAPagarNuevoPrestamo)</dd>
                    <dt class="col-sm-6">Deuda actual del cliente</dt>
                    <dd class="col-sm-6">@Formato.Monto(Model.DeudaActual)</dd>
                    <dt class="col-sm-6">Deuda proyectada</dt>
                    <dd class="col-sm-6">@Formato.Monto(Model.DeudaProyectada)</dd>
                    <dt class="col-sm-6">Deuda promedio del sistema</dt>
                    <dd class="col-sm-6">@Formato.Monto(Model.DeudaPromedio)</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" asp-action="Asignar">Cancelar</a>
                <form asp-action="ConfirmarAsignacion" method="post" class="d-inline">
                    <input type="hidden" asp-for="ClientId" />
                    <input type="hidden" asp-for="ClienteNombre" />
                    <input type="hidden" asp-for="TermInMonths" />
                    <input type="hidden" asp-for="CapitalAmount" />
                    <input type="hidden" asp-for="AnnualInterestRate" />
                    <input type="hidden" asp-for="Advertencia" />
                    <input type="hidden" asp-for="DeudaActual" />
                    <input type="hidden" asp-for="DeudaProyectada" />
                    <input type="hidden" asp-for="DeudaPromedio" />
                    <input type="hidden" asp-for="TotalAPagarNuevoPrestamo" />
                    <button type="submit" class="btn btn-primary">Confirmar asignación</button>
                </form>
            </div>
        </div>
    </div>
</div>
