@model SeleccionarClienteViewModel
@{
    ViewData["Title"] = "Asignar préstamo";
}

<h2 class="abp-page-title">Asignar préstamo — Paso 1: seleccionar cliente</h2>
<div class="abp-divider-accent"></div>

<div class="alert alert-info">
    Deuda promedio del sistema: <strong>@Formato.Monto(Model.DeudaPromedio)</strong>
</div>

<form asp-action="Asignar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-validation mb-2"></div>
    <span asp-validation-for="ClientId" class="text-validation d-block mb-2"></span>

    <div class="card">
        <div class="table-responsive">
            <table class="table abp-table mb-0">
                <thead>
                <tr>
                    <th></th>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Deuda total</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay clientes elegibles para asignación de préstamo.</td></tr>
                }
                @foreach (var cliente in Model.Clientes)
                {
                    <tr>
                        <td>
                            <input class="form-check-input" type="radio" name="ClientId" value="@cliente.UserId"
                                   checked="@(Model.ClientId == cliente.UserId)" />
                        </td>
                        <td>@cliente.Identification</td>
                        <td>@cliente.FullName</td>
                        <td>@cliente.Email</td>
                        <td class="abp-monto">@Formato.Monto(cliente.TotalDebt)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary" @(Model.Clientes.Count == 0 ? "disabled" : null)>Continuar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
