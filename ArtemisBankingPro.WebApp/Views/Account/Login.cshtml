@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<h1 class="h5 text-center mb-3">Iniciar sesión</h1>

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-validation mb-2"></div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="UserName" class="text-validation"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-validation"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Entrar</button>
</form>

<div class="text-center mt-3">
    <a asp-action="SolicitarReset">¿Olvidó su contraseña?</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
