@model RestablecerViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Nueva contraseña";
}

<h1 class="h5 text-center mb-3">Establecer nueva contraseña</h1>

<form asp-action="Restablecer" method="post">
    <div asp-validation-summary="ModelOnly" class="text-validation mb-2"></div>
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password" class="text-validation"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-validation"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Restablecer contraseña</button>
</form>

<div class="text-center mt-3">
    <a asp-action="Login">Volver al inicio de sesión</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
